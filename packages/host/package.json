{
  "name": "@remora/host",
  "version": "1.0.0",
  "private": true,
  "description": "Remora host: DeepSeek Harness bundle + Cordis plugin (the PC side of Remora)",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "pnpm --filter \"@remora/host^...\" run build && tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "koffi": "3.3.2",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.3",
    "@deepseek-ai/dsh-api-gateway": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@remora/crypto": "workspace:*",
    "@remora/protocol": "workspace:*",
    "@remora/relay-link": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "tsdown": "^0.23.0"
  }
}
