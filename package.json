{
  "name": "remora",
  "private": true,
  "description": "Remote control for the DeepSeek Harness from Android, via a self-hosted E2E relay",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/cli\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint packages apps/relay/src apps/cli/src scripts",
    "test": "pnpm -r run test && vitest run --config scripts/vitest.config.ts",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "test:real-dsh": "vitest run --config tests/real-dsh/vitest.config.ts",
    "test:security": "vitest run --config tests/security/vitest.config.ts",
    "test:perf": "vitest run --config tests/perf/vitest.config.ts",
    "conformance:check": "node scripts/check-conformance.mjs",
    "check:no-stubs": "node scripts/check-no-stubs.mjs",
    "upstream:fetch": "node scripts/fetch-upstream.mjs",
    "issues:sync": "node scripts/sync-issues.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.85.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "yaml": "^2.8.0"
  }
}
