{
  "suite": "relay/data-frame",
  "version": 1,
  "source": "Authored deterministic examples in packages/protocol/scripts/gen-rcp-vectors.mjs from RCP/1 and existing TS schemas; not captured implementation output; execution/independent verification deferred.",
  "notes": "input.hex is the exact frame; expect decodes version/type/channel/peerKind numerically and peerId/payload as lowercase hex, matching both language codecs. Error labels name the rejected header invariant. Reserved bytes are zero and never validated by the codecs; relay-level reserved-byte rejection lives above this layer.",
  "cases": [
    {
      "name": "host to device with payload",
      "input": {
        "hex": "010100000000002a02000102030405060708090a0b0c0d0e0f00000070696e67"
      },
      "expect": {
        "version": 1,
        "type": 1,
        "channel": 42,
        "peerKind": 2,
        "peerId": "000102030405060708090a0b0c0d0e0f",
        "payload": "70696e67"
      }
    },
    {
      "name": "device to host empty payload",
      "input": {
        "hex": "010100000000000101000102030405060708090a0b0c0d0e0f000000"
      },
      "expect": {
        "version": 1,
        "type": 1,
        "channel": 1,
        "peerKind": 1,
        "peerId": "000102030405060708090a0b0c0d0e0f",
        "payload": ""
      }
    },
    {
      "name": "u32 channel boundary",
      "input": {
        "hex": "01010000ffffffff02000102030405060708090a0b0c0d0e0f000000ff"
      },
      "expect": {
        "version": 1,
        "type": 1,
        "channel": 4294967295,
        "peerKind": 2,
        "peerId": "000102030405060708090a0b0c0d0e0f",
        "payload": "ff"
      }
    },
    {
      "name": "header truncated",
      "input": {
        "hex": "000000000000000000000000000000000000000000000000000000"
      },
      "error": "too_short"
    },
    {
      "name": "unsupported version byte",
      "input": {
        "hex": "020100000000002a02000102030405060708090a0b0c0d0e0f000000"
      },
      "error": "version"
    },
    {
      "name": "unsupported type byte",
      "input": {
        "hex": "010200000000002a02000102030405060708090a0b0c0d0e0f000000"
      },
      "error": "type"
    },
    {
      "name": "unknown peer kind",
      "input": {
        "hex": "010100000000002a03000102030405060708090a0b0c0d0e0f000000"
      },
      "error": "peer_kind"
    }
  ]
}
