      "input": {
        "value": {
          "t": "enroll.ticket",
          "rid": "r1"
        }
      },
      "expect": {
        "t": "enroll.ticket",
        "rid": "r1"
      }
    },
    {
      "name": "enroll ticket granted",
      "input": {
        "value": {
          "t": "enroll.ticket.ok",
          "rid": "r1",
          "ticket": "AQgPFh0kKzI5QEdOVVxjanF4f4aNlJuiqbC3vsXM09o",
          "expiresAt": 1791159000000
        }
      },
      "expect": {
        "t": "enroll.ticket.ok",
        "rid": "r1",
        "ticket": "AQgPFh0kKzI5QEdOVVxjanF4f4aNlJuiqbC3vsXM09o",
        "expiresAt": 1791159000000
