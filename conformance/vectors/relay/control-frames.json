      "name": "ping",
      "input": {
        "value": {
          "t": "ping"
        }
      },
      "expect": {
        "t": "ping"
      }
    },
    {
      "name": "pong",
      "input": {
        "value": {
          "t": "pong"
        }
      },
      "expect": {
        "t": "pong"
      }
    },
    {
