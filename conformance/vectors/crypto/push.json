{
  "suite": "crypto/push",
  "version": 1,
  "source": "Crypto/1 §8 push encryption",
  "notes": "ChaCha20-Poly1305 with AAD \"remora/1 push\\0hostId\\0deviceId\"; 12-byte nonce prefix",
  "cases": [
    {
      "name": "opens a sealed payload under the matching host/device context",
      "input": {
        "pushKeyB64u": "VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVU",
        "hostId": "h_erruijsx3ey2rmxcpeh3pgxjkm",
        "deviceId": "d_erruijsx3ey2rmxcpeh3pgxjkm",
        "sealedB64u": "AAECAwQFBgcICQoLMC7t5F4ZOEZW5LzKxfzq6m8jwG9aZaqJ1XVaWWjbO-dFG5M1MTk9w3ZSGrf4lBj3KUr0hD30s-fWvDJ01Cgby99t9J6DiKAoay8MhG5XJDpj9Cpwihc"
      },
      "expect": {
        "plaintextJson": "{\"v\":1,\"kind\":\"approval\",\"at\":1790000000000,\"title\":\"Approval needed\"}"
      }
    },
    {
      "name": "tampered ciphertext fails closed",
      "input": {
        "pushKeyB64u": "VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVU",
        "hostId": "h_erruijsx3ey2rmxcpeh3pgxjkm",
        "deviceId": "d_erruijsx3ey2rmxcpeh3pgxjkm",
        "sealedB64u": "AAECAwQFBgcICQoLMC7t5F4ZOEZX5LzKxfzq6m8jwG9aZaqJ1XVaWWjbO-dFG5M1MTk9w3ZSGrf4lBj3KUr0hD30s-fWvDJ01Cgby99t9J6DiKAoay8MhG5XJDpj9Cpwihc"
      },
      "expect": {
        "valid": false
      }
    },
    {
      "name": "mismatched device context fails closed",
      "input": {
        "pushKeyB64u": "VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVU",
        "hostId": "h_erruijsx3ey2rmxcpeh3pgxjkm",
        "deviceId": "d_erruijsx3ey2rmxcpeh3pgxjki",
        "sealedB64u": "AAECAwQFBgcICQoLMC7t5F4ZOEZW5LzKxfzq6m8jwG9aZaqJ1XVaWWjbO-dFG5M1MTk9w3ZSGrf4lBj3KUr0hD30s-fWvDJ01Cgby99t9J6DiKAoay8MhG5XJDpj9Cpwihc"
      },
      "expect": {
        "valid": false
