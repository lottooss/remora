        "pushKeyB64u": "VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVU",
        "hostId": "h_erruijsx3ey2rmxcpeh3pgxjkm",
        "deviceId": "d_erruijsx3ey2rmxcpeh3pgxjkm",
        "sealedB64u": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
