          "sessionId": "session-vector-1",
          "seq": 3,
          "offset": 0,
          "limit": 1024
        }
      },
      "expect": {
        "sessionId": "session-vector-1",
        "seq": 3,
        "offset": 0,
        "limit": 1024
      }
    },
    {
      "name": "valid response payload",
      "input": {
        "direction": "result",
        "value": {
          "text": "Ready to review.",
          "offset": 0,
          "eof": true
        }
      },
      "expect": {
        "text": "Ready to review.",
        "offset": 0,
        "eof": true
      }
    },
    {
      "name": "malformed request parameters",
      "input": {
        "direction": "params",
        "value": {
          "sessionId": "session-vector-1",
          "seq": 3,
          "offset": -1
        }
      },
      "error": "invalid_params"
    },
    {
      "name": "malformed response payload",
