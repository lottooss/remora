        }
      },
      "expect": {
        "path": "C:\\Projects\\remora"
      }
    },
    {
      "name": "valid response payload",
      "input": {
        "direction": "result",
        "value": {
          "path": "C:\\Projects\\remora",
          "parent": "C:\\Projects",
          "entries": [
            {
              "name": "src",
              "kind": "dir"
            },
            {
              "name": "README.md",
              "kind": "file"
            }
          ],
          "truncated": false
        }
      },
      "expect": {
        "path": "C:\\Projects\\remora",
        "parent": "C:\\Projects",
        "entries": [
          {
            "name": "src",
            "kind": "dir"
          },
          {
            "name": "README.md",
            "kind": "file"
          }
        ],
        "truncated": false
      }
    },
    {
