{
  "suite": "rcp/methods/sessions.follow",
  "version": 1,
  "source": "Authored deterministic examples in packages/protocol/scripts/gen-rcp-vectors.mjs from RCP/1 and existing TS schemas; not captured implementation output; execution/independent verification deferred.",
  "notes": "input.direction chooses params/result/item/error; value is the actual JSON payload. expect is the decoded payload; error labels invalid_params/invalid_result/invalid_item/invalid_error are corpus validation categories, not host execution results. No approval digest/signature validity, policy enforcement, or exactly-once effects are claimed. Method name comes from the filename; suite labels are lowercase to satisfy the existing vector-file schema.",
  "cases": [
    {
      "name": "valid request parameters",
      "input": {
        "direction": "params",
        "value": {
          "sessionId": "session-vector-1",
          "afterSeq": 2,
          "live": true
        }
      },
      "expect": {
        "sessionId": "session-vector-1",
        "afterSeq": 2,
        "live": true
      }
    },
    {
      "name": "valid response payload",
      "input": {
        "direction": "result",
        "value": {
          "sid": 9
        }
      },
      "expect": {
        "sid": 9
      }
    },
    {
      "name": "malformed request parameters",
      "input": {
        "direction": "params",
        "value": {
          "sessionId": "session-vector-1",
          "afterSeq": -1
        }
      },
      "error": "invalid_params"
    },
    {
      "name": "malformed response payload",
      "input": {
        "direction": "result",
        "value": {}
      },
      "error": "invalid_result"
    },
    {
      "name": "not found error payload",
      "input": {
        "direction": "error",
        "value": {
          "code": "not_found",
          "message": "Requested resource is unavailable."
        }
      },
      "expect": {
        "code": "not_found",
        "message": "Requested resource is unavailable."
      }
    },
    {
      "name": "snapshot with retained transcript",
      "input": {
        "direction": "item",
        "value": {
          "type": "snapshot",
          "session": {
            "id": "session-vector-1",
            "title": "Review changes",
            "workspace": {
              "id": "workspace-vector-1",
              "path": "C:\\Projects\\remora",
              "title": "Remora"
            },
            "status": "idle",
            "updatedAt": 1791158400000,
            "model": {
              "provider": "deepseek",
              "model": "deepseek-chat",
              "reasoningEffort": "high"
            }
          },
          "events": [
            {
              "kind": "assistant.message",
              "seq": 3,
              "at": 1791158400000,
              "text": "Ready to review.",
              "model": {
                "provider": "deepseek",
                "model": "deepseek-chat",
                "reasoningEffort": "high"
              }
            }
          ],
          "hasOlder": false
        }
      },
      "expect": {
        "type": "snapshot",
        "session": {
          "id": "session-vector-1",
          "title": "Review changes",
          "workspace": {
            "id": "workspace-vector-1",
            "path": "C:\\Projects\\remora",
            "title": "Remora"
          },
          "status": "idle",
          "updatedAt": 1791158400000,
          "model": {
            "provider": "deepseek",
            "model": "deepseek-chat",
            "reasoningEffort": "high"
          }
        },
        "events": [
          {
            "kind": "assistant.message",
            "seq": 3,
            "at": 1791158400000,
            "text": "Ready to review.",
            "model": {
              "provider": "deepseek",
              "model": "deepseek-chat",
              "reasoningEffort": "high"
            }
          }
        ],
        "hasOlder": false
      }
    },
    {
      "name": "durable events batch",
      "input": {
        "direction": "item",
        "value": {
          "type": "events",
          "events": [
            {
              "kind": "assistant.message",
              "seq": 3,
              "at": 1791158400000,
              "text": "Ready to review.",
              "model": {
                "provider": "deepseek",
                "model": "deepseek-chat",
                "reasoningEffort": "high"
              }
            }
          ]
        }
      },
      "expect": {
        "type": "events",
        "events": [
          {
            "kind": "assistant.message",
            "seq": 3,
            "at": 1791158400000,
            "text": "Ready to review.",
            "model": {
              "provider": "deepseek",
              "model": "deepseek-chat",
              "reasoningEffort": "high"
            }
          }
        ]
      }
    },
    {
      "name": "live attempt starts",
      "input": {
        "direction": "item",
        "value": {
          "type": "live.start",
          "attempt": "attempt-1",
          "afterSeq": 3
        }
      },
      "expect": {
        "type": "live.start",
        "attempt": "attempt-1",
        "afterSeq": 3
      }
    },
    {
      "name": "coalesced live delta",
      "input": {
        "direction": "item",
        "value": {
          "type": "live.delta",
          "attempt": "attempt-1",
          "index": 0,
          "text": "Next",
          "reasoning": "Review"
        }
      },
      "expect": {
        "type": "live.delta",
        "attempt": "attempt-1",
        "index": 0,
        "text": "Next",
        "reasoning": "Review"
      }
    },
    {
      "name": "live attempt settles",
      "input": {
        "direction": "item",
        "value": {
          "type": "live.end",
          "attempt": "attempt-1",
          "outcome": "settled"
        }
      },
      "expect": {
        "type": "live.end",
        "attempt": "attempt-1",
        "outcome": "settled"
      }
    },
    {
      "name": "cursor reset",
      "input": {
        "direction": "item",
        "value": {
          "type": "reset",
          "reason": "cursor_unavailable"
        }
      },
      "expect": {
        "type": "reset",
        "reason": "cursor_unavailable"
      }
    },
    {
      "name": "negative live index",
      "input": {
        "direction": "item",
        "value": {
          "type": "live.delta",
          "attempt": "attempt-1",
          "index": -1
        }
      },
      "error": "invalid_item"
    }
  ]
}
