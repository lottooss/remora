{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lottooss/remora/conformance/schema/vector-file.schema.json",
  "title": "Remora conformance vector file (v0; finalized by task P0-A1)",
  "type": "object",
  "required": ["suite", "version", "source", "cases"],
  "additionalProperties": false,
  "properties": {
    "suite": { "type": "string", "pattern": "^[a-z0-9-]+(/[a-z0-9.-]+)+$" },
    "version": { "type": "integer", "minimum": 1 },
    "source": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "input"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "input": { "type": "object" },
          "expect": {},
          "error": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        },
        "oneOf": [
          { "required": ["expect"], "not": { "required": ["error"] } },
          { "required": ["error"], "not": { "required": ["expect"] } }
        ]
      }
    }
  }
}
