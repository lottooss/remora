{
  "name": "@remora/p0-s1-dsh-adapter",
  "version": "0.0.0",
  "private": true,
  "description": "P0-S1 throwaway bundle: prove out-of-tree Cordis plugin capabilities inside an npm-installed dsh",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
